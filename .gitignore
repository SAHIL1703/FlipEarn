# --- General & System Files ---
.DS_Store
Thumbs.db
*.log
tmp/
temp/

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Dependencies (Recursive) ---
# This ignores node_modules in root, client, and server
node_modules/
pnpm-lock.yaml
yarn-error.log
package-lock.json
# Note: Keep package-lock.json if you want to commit versions, 
# but ignore it if you strictly use Yarn/PNPM and don't want conflicts.

# --- Environment Variables ---
# CRITICAL: Never commit .env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# --- Build Outputs (Client & Server) ---
dist/
build/
out/
coverage/
.docusaurus/

# --- Framework Specifics (Client) ---
# Next.js
.next/
# Nuxt.js
.nuxt/
.output/
# Angular
.angular/

# --- Runtime Data (Server) ---
# Database files (if using SQLite locally)
*.sqlite
*.sqlite3
*.db

# Uploads/Storage (if you store user uploads locally)
uploads/
storage/
public/uploads/

# --- Testing ---
lcov.info
.nyc_output/
reports/
junit.xml

# --- Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*